# Site gerado
site/dist/

# Microdados e bases brutas (grandes demais para o repositório)
etl/dados/
etl/*.CSV
etl/*.csv
etl/*.ZIP
etl/*.zip
etl/*.7z
!etl/qualidade_uf.csv

# Área de trabalho da RAIS. O padrão de `--tmp` é etl/dados/_rais_tmp, que já
# está coberto acima; esta linha pega o caso de alguém apontar --tmp para
# dentro do repositório. Um `.7z` de 1 GB commitado por acidente é um problema
# que não dá para desfazer com um commit.
_rais_tmp/

# Dumps de depuração (conteúdo derivável de data/*.json)
*_dump.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# OS
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Logs de execução do pipeline (derivados, não são dado)
data/_*.log
